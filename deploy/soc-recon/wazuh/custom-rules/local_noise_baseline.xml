  <!--
    PATH-search misses: execvp tries each PATH directory in turn and every
    miss is a failed execve (ENOENT, exit -2) under the caller's exe. The SCA
    scan looks for CIS-check tools the container does not ship (findmnt, sshd,
    systemctl, modprobe, ...), and xargs looks for rpm. About 2,000 a day.
    Blind to: modulesd or xargs failing to find a bare name on PATH.
  -->
  <rule id="100118" level="0">
    <if_sid>80792</if_sid>
    <field name="audit.auid" type="pcre2">^4294967295$</field>
    <field name="audit.tty" type="pcre2">^\(none\)$</field>
    <field name="audit.exe" type="pcre2">^(/var/ossec/bin/wazuh-modulesd|/usr/bin/xargs)$</field>
    <field name="audit.cwd" type="pcre2">^/var/ossec$</field>
    <field name="audit.uid" type="pcre2">^0$</field>
    <field name="audit.euid" type="pcre2">^0$</field>
    <field name="audit.gid" type="pcre2">^0$</field>
    <field name="audit.success" type="pcre2">^no$</field>
    <field name="audit.exit" type="pcre2">^-2$</field>
    <regex type="pcre2">subj=docker-default key="audit-wazuh-c".*type=PATH msg=audit\(\d+\.\d+:\d+\): item=0 name="(/usr/local/sbin|/usr/local/bin|/usr/sbin|/usr/bin|/sbin|/bin)/[A-Za-z0-9_.-]+" nametype=UNKNOWN </regex>
    <description>Noise baseline: manager PATH-search miss.</description>
  </rule>


    <field name="audit.gid" type="pcre2">^0$</field>
    <regex type="pcre2">subj=docker-default key="audit-wazuh-c".*type=EXECVE msg=audit\(\d+\.\d+:\d+\): argc=3 a0="suricatasc" a1="-c" a2="uptime" type=</regex>
    <description>Noise baseline: Suricata healthcheck suricatasc.</description>
  </rule>


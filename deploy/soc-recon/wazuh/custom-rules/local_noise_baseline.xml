<!--
  B.0 noise baseline: level-0 children of stock rule 80792 ("Audit: Command"),
  the host auditd execve alert. Phase B ISA F1; table in
  phase-b-detection/NOISE-BASELINE.md. IDs 100100-100199.

  Why these exist: the SOC box audits every execve on the host kernel, and the
  containers run on that kernel, so the stack alerts on its own healthchecks
  and on the manager's own monitors. Measured 2026-10-24 (a quiet day): 19,973
  of 20,708 alerts were 80792, and these shapes were about 18,400 of them.

  How each rule is keyed (ISA constraints):
    - at the Wazuh rule layer, never in auditd (c1e715c)
    - no login session (auid unset) and no tty, so anything a person runs,
      on the host or through `docker exec -it`, still alerts
    - the full exe path and the cwd
    - the uid, euid and gid the shape really runs as (gid 999 is the
      manager's wazuh group, 108 the host's)
    - the AppArmor label in the SYSCALL record: docker-default for a
      container, runc for runc, unconfined for the host. cwd /var/ossec is
      both the manager container and the host's own agent 002, and the label
      is what tells them apart, so tier 2 has one rule per origin
    - the exact argv, as a pcre2 match on the EXECVE record in full_log. The
      auditd decoder stops at a7 and leaves hex-encoded args undecoded, so the
      argv is only complete in full_log. argc pins the count, and the trailing
      " type=" pins the last argument's end.

  Hex: auditd writes an argument as hex when it holds a space, quote or
  control byte, so shell command strings appear hex-encoded. Each one below
  carries its plain text in the comment above it.

  WARN: what these rules cannot see (Forge audit, 2026-10-25):
    - the parent. A process that repeats a shape exactly is suppressed.
    - the environment. EXECVE carries no envp, so an exact argv can still run
      other code: LD_PRELOAD, a planted config file (.curlrc, rpm macros), a
      sourced file. "Exact argv" is not "exact behavior".
    - the binary. exe and cwd are paths inside the process's own mount
      namespace, and docker-default is shared by every container. Root in
      any container that can write /usr/bin can swap in its own binary
      and run it under a suppressed shape. Per-service AppArmor labels and
      read-only root filesystems would close this; neither exists yet.
    - the event afterwards. logall is off, so a suppressed exec is not
      archived at the manager. The only copy is the SOC box's own
      /var/log/audit/audit.log.
  Each of these needs code execution on the box or in a container first.
  They are accepted residual risk, recorded in NOISE-BASELINE.md.

  Lint: bun tools/noise-lint.ts (ISA ISC-112).
-->
<group name="audit,local,noise_baseline,">

  <!-- Tier 1: container healthchecks -->

  <!--
    `runc init`, the first exec inside a container for every healthcheck run
    and every `docker exec`, about 4,300 a day. The overlay cwd changes on
    recreate, so it is pinned to its shape.
    Blind to: runc init itself. The exec'd child still alerts on its own
    unless another rule here names it.
  -->
  <rule id="100100" level="0">
    <if_sid>80792</if_sid>
    <field name="audit.auid" type="pcre2">^4294967295$</field>
    <field name="audit.tty" type="pcre2">^\(none\)$</field>
    <field name="audit.exe" type="pcre2">^/runc$</field>
    <field name="audit.cwd" type="pcre2">^/var/lib/docker/rootfs/overlayfs/[0-9a-f]{64}$</field>
    <field name="audit.uid" type="pcre2">^0$</field>
    <field name="audit.euid" type="pcre2">^0$</field>
    <field name="audit.gid" type="pcre2">^0$</field>
    <regex type="pcre2">subj=runc key="audit-wazuh-c".*type=EXECVE msg=audit\(\d+\.\d+:\d+\): argc=2 a0="runc" a1="init" type=</regex>
    <description>Noise baseline: runc init for a container exec.</description>
  </rule>

  <!--
    The indexer healthcheck (docker-compose.yml, every 30s), about 2,900 a day.
    The & in the URL is written \x26: the Wazuh XML parser does not decode
    entities, so &amp; would reach PCRE2 as five literal characters.
    All 15 arguments are pinned, so bin/idx (-sS -g) and any other curl to
    _cluster/health still alert (ISA ISC-113).
    Blind to: this exact curl, cert paths and URL included.
  -->
  <rule id="100101" level="0">
    <if_sid>80792</if_sid>
    <field name="audit.auid" type="pcre2">^4294967295$</field>
    <field name="audit.tty" type="pcre2">^\(none\)$</field>
    <field name="audit.exe" type="pcre2">^/usr/bin/curl$</field>
    <field name="audit.cwd" type="pcre2">^/usr/share/wazuh-indexer$</field>
    <field name="audit.uid" type="pcre2">^1000$</field>
    <field name="audit.euid" type="pcre2">^1000$</field>
    <field name="audit.gid" type="pcre2">^1000$</field>
    <regex type="pcre2">subj=docker-default key="audit-wazuh-c".*type=EXECVE msg=audit\(\d+\.\d+:\d+\): argc=15 a0="curl" a1="-sf" a2="-o" a3="/dev/null" a4="-m" a5="8" a6="--cacert" a7="/usr/share/wazuh-indexer/config/certs/root-ca\.pem" a8="--cert" a9="/usr/share/wazuh-indexer/config/certs/admin\.pem" a10="--key" a11="/usr/share/wazuh-indexer/config/certs/admin-key\.pem" a12="--resolve" a13="wazuh\.indexer:9200:127\.0\.0\.1" a14="https://wazuh\.indexer:9200/_cluster/health\?wait_for_status=yellow\x26timeout=5s" type=</regex>
    <description>Noise baseline: indexer healthcheck curl.</description>
  </rule>

  <!--
    The Suricata healthcheck shell (CMD-SHELL, every 60s), about 1,450 a day.
    a2 is: suricatasc -c uptime >/dev/null 2>&1 || exit 1
    Blind to: this exact shell line.
  -->
  <rule id="100102" level="0">
    <if_sid>80792</if_sid>
    <field name="audit.auid" type="pcre2">^4294967295$</field>
    <field name="audit.tty" type="pcre2">^\(none\)$</field>
    <field name="audit.exe" type="pcre2">^/usr/bin/bash$</field>
    <field name="audit.cwd" type="pcre2">^/$</field>
    <field name="audit.uid" type="pcre2">^0$</field>
    <field name="audit.euid" type="pcre2">^0$</field>
    <field name="audit.gid" type="pcre2">^0$</field>
    <regex type="pcre2">subj=docker-default key="audit-wazuh-c".*type=EXECVE msg=audit\(\d+\.\d+:\d+\): argc=3 a0="/bin/sh" a1="-c" a2=73757269636174617363202D6320757074696D65203E2F6465762F6E756C6C20323E2631207C7C20657869742031 type=</regex>
    <description>Noise baseline: Suricata healthcheck shell.</description>
  </rule>

  <!--
    The Suricata healthcheck itself, about 1,450 a day.

    <field name="audit.euid" type="pcre2">^0$</field>
    <field name="audit.gid" type="pcre2">^999$</field>
    <regex type="pcre2">subj=docker-default key="audit-wazuh-c".*type=EXECVE msg=audit\(\d+\.\d+:\d+\): argc=6 a0="/usr/bin/coreutils" a1="--coreutils-prog-shebang=sort" a2="/usr/bin/sort" a3="-k" a4="4" a5="-g" type=</regex>

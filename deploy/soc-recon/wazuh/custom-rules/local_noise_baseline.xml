  <!--
    Read-only rpm queries: the SCA scan's `rpm -q <package>` (is it
    installed) and syscollector's `rpm -qa`, `rpm -qa` with a query format and
    `rpm -ql python3-<package>`. Package names use a strict charset.
    Blind to: those query argvs. The argv installs and erases nothing; what
    the binary and its macro files do is outside what auditd records.
  -->
  <rule id="100116" level="0">
    <if_sid>80792</if_sid>
    <field name="audit.auid" type="pcre2">^4294967295$</field>
    <field name="audit.tty" type="pcre2">^\(none\)$</field>
    <field name="audit.exe" type="pcre2">^/usr/bin/rpm$</field>
    <field name="audit.cwd" type="pcre2">^/var/ossec$</field>
    <field name="audit.uid" type="pcre2">^0$</field>
    <field name="audit.euid" type="pcre2">^0$</field>
    <field name="audit.gid" type="pcre2">^0$</field>
    <regex type="pcre2">subj=docker-default key="audit-wazuh-c".*type=EXECVE msg=audit\(\d+\.\d+:\d+\): (argc=2 a0="rpm" a1="-qa"|argc=3 a0="rpm" a1="-q" a2="[A-Za-z0-9][A-Za-z0-9._+-]*"|argc=3 a0="rpm" a1="-ql" a2="python3-[A-Za-z0-9._+-]+"|argc=4 a0="rpm" a1="-qa" a2="--qf" a3=[0-9A-F]+) type=</regex>
    <description>Noise baseline: manager SCA and syscollector rpm query.</description>
  </rule>

  <!--

# Copy to .env and adjust. The real .env is gitignored.

# ── Wazuh stack version ──────────────────────────────────────────────
# Pin to the stable you actually run. Bump deliberately, not automatically.
WAZUH_VERSION=4.14.6

# ── Indexer JVM heap ─────────────────────────────────────────────────
# OpenSearch heap. Keep it == the mem_reservation floor in compose, and
# never more than ~50% of the box's RAM. Sized here for a 16 GB host
# (see README "Resource budget — 16 GB host"). Raise to 4g only after a
# RAM upgrade past 32 GB.
INDEXER_HEAP=2g

# ── Stack credentials ────────────────────────────────────────────────
# These feed BOTH the running containers (compose env) AND the digest below.
# The defaults are the WELL-KNOWN Wazuh single-node defaults — fine for the
# first LAN-only bring-up behind UFW, but CHANGE THEM before any exposure.
# Changing the indexer/dashboard passwords also means regenerating the bcrypt
# hashes in config/wazuh_indexer/internal_users.yml and re-running securityadmin
# — see README "Hardening (before exposure)". Keep the real .env out of git.
#
# NO INLINE COMMENTS ON THESE LINES. Everything after `=` is the value — a trailing
# `# note` becomes part of the password and you get "Authentication finally failed
# for admin" with no hint as to why. Keep annotations above the line, never beside it.
#
# Use alphanumerics only. These get interpolated into the indexer healthcheck's
# `curl -u admin:...` inside a CMD-SHELL, and `$` triggers compose variable expansion.
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
#
# admin — indexer + dashboard login, filebeat, and the CASA digest script.
# Must match the `admin` bcrypt hash in config/wazuh_indexer/internal_users.yml.
WAZUH_INDEXER_PASS=SecretPassword
# kibanaserver — the dashboard's own service account.
# Must match the `kibanaserver` bcrypt hash in internal_users.yml.
WAZUH_DASHBOARD_PASS=kibanaserver
# wazuh-wui — the Wazuh manager API user. NOT an indexer internal user; it lives in
# the manager's RBAC db under the wazuh_api_configuration volume.
WAZUH_API_PASS=MyS3cr37P450r.*-

# ── CASA digest (digest/generate_digest.py) ──────────────────────────
# Where the digest pulls Wazuh alerts from (the indexer / OpenSearch API).
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USER=admin
# (digest reuses WAZUH_INDEXER_PASS above)
# Alert severity floor + lookback window for the digest.
DIGEST_MIN_LEVEL=12
DIGEST_LOOKBACK=24h

# Optional inline LLM rewrite of the digest markdown. Off by default.
# THIS IS NOT CASA. It's a standalone convenience (a one-shot Claude rewrite for quick
# reading). The capstone reasoning layer is CASA (github.com/ktalons/casa-ai-agent),
# which consumes digest/{date}-intake.json — not this toggle. Keep this dumb on purpose.
DIGEST_LLM=0
ANTHROPIC_API_KEY=
DIGEST_LLM_MODEL=claude-haiku-4-5-20251001

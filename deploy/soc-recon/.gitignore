# Runtime + secrets for the soc-recon bundle — never commit these.
.env
data/                 # recon run outputs + triage working dir (host-visible volume)
scope/domains.txt     # live scope; only domains.txt.example is tracked
config/wazuh_indexer_ssl_certs/   # generated TLS certs + private keys — never commit
# Holds real bcrypt password hashes once rotated off the Wazuh demo defaults.
# Publishing password hashes to a public portfolio repo is exactly what ISA
# "no real secrets committed" exists to prevent. Only the .example is tracked.
config/wazuh_indexer/internal_users.yml
# Holds the wazuh-wui API password in PLAINTEXT. Only the .example is tracked.
config/wazuh_dashboard/wazuh.yml
# Agent enrollment password, plaintext. Only the .example is tracked.
wazuh/authd.pass

# Generated triage + digest artifacts (the .example templates ARE tracked)
triage/*_baseline.md
triage/*_delta.md
digest/*-digest.md
digest/*-intake.json
!digest/example-digest.md

# macOS
.DS_Store

%% TalonSocLab — Phase A Foundation SOC Stack (docker-compose edition)
%% Single source of truth for the container topology + data flow.
%% Companion: network-topology.mmd holds the physical / L2 network (router, switch, rack).
%% Host: HP EliteDesk mini (6-core i5, 16 GB, 256 GB NVMe) — OWNED outright.
%% Substrate: Ubuntu Server 26.04 LTS bare-metal + Docker (no Proxmox).
%% Legend: solid = running now · dashed edge = telemetry / handoff
%% Deployment status verified on the box 2026-09-30: indexer, manager, dashboard, suricata and
%%   all three agents are up. The attack-surface recon pipeline once planned for this box was
%%   never deployed and left the public repo 2026-11-04.
%% Host timers checked 2026-10-15: three root-owned systemd oneshots (deploy/soc-recon/systemd/)
%%   rotate Suricata's logs at 04:00Z, update ET Open at 04:30Z and delete the manager's dated
%%   logs past 14 days at 05:00Z. A failed run starts the OnFailure handler, and the
%%   status=1/FAILURE line reaches the manager through agent 002 as rule 40704 (level 5).
%% PIVOT NOTE: this replaced an earlier Proxmox/pfSense/VLAN topology. It trades
%%   network realism (pfSense, VLANs, Windows endpoint VMs) for portability +
%%   detection breadth.
%% Endpoints are Wazuh agents on REAL devices, not VMs — keeps the 16 GB budget clear.

    Internet((Internet))

    subgraph Host["HP EliteDesk mini — Ubuntu 26.04 + Docker"]
        direction TB

        subgraph SocNet["docker network: soc"]
            Indexer["wazuh.indexer<br/>OpenSearch :9200<br/>heap 2g / cap 4g"]
            Manager["wazuh.manager<br/>:1514 agent, :1515 enroll, :55000 API<br/>custom-rules mount: Suricata tuning live, Sigma XML in Phase B<br/>cont-init override: filebeat init keeps the indexer password out of argv"]
            Dashboard["wazuh.dashboard<br/>:443 web UI"]
        end

        Suricata["suricata · host network<br/>AF_PACKET on eno1 · ET Open<br/>eve.json on the host disk"]

        Timers["host systemd timers<br/>suricata-logrotate 04:00Z · suricata-update 04:30Z<br/>wazuh-retention 05:00Z (14-day manager logs)<br/>OnFailure: soc-recon-unit-failed@"]
    end

    subgraph Endpoints["Real-device Wazuh agents (no VMs on the box) — all Active"]
        Win["Dell OptiPlex<br/>Windows 11 Pro · Sysmon + agent 001"]
        Mac["MacBook<br/>filtered unified log · agent 003"]
        UbuntuHost["EliteDesk, self-monitoring<br/>auditd + eve.json · agent 002"]
    end

    Analyst(["Analyst, on the MacBook<br/>HTTPS to dashboard"])
    CASA["CASA — casa-ai-agent<br/>multi-agent reasoning on Claude<br/>(separate plane, not yet fed)"]

    Internet ==> Host
    Win  -. "TLS 1514" .-> Manager
    Mac  -. "TLS 1514" .-> Manager
    UbuntuHost -. "TLS 1514" .-> Manager
    Suricata -. "eve.json (host file)" .-> UbuntuHost
    Timers -. "rotate logs, swap in new rules" .-> Suricata
    Timers -. "delete dated logs past 14 days" .-> Manager
    Timers -. "failed run: journal line → rule 40704 (level 5)" .-> UbuntuHost

    Manager --> Indexer
    Indexer --> Dashboard
    Analyst ==> Dashboard

    Indexer -. "alerts (handoff not built yet)" .-> CASA
    CASA -. "explainable, NIST-aligned analysis" .-> Analyst

    classDef soc fill:#0f172a,stroke:#f59e0b,color:#fff
    classDef ep fill:#0f172a,stroke:#34d399,color:#fff
    classDef ext fill:#374151,stroke:#9ca3af,color:#fff
    classDef casa fill:#3b0764,stroke:#c084fc,color:#fff

    class Indexer,Manager,Dashboard,Suricata,Timers soc
    class Win,Mac,UbuntuHost ep
    class Internet,Analyst ext
    class CASA casa

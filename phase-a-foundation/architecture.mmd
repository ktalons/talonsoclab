flowchart TB
%% TalonSocLab — Phase A Foundation SOC Stack (docker-compose edition)
%% Single source of truth for the container topology + data flow.
%% Companion: network-topology.mmd holds the physical / L2 network (router, switch, rack).
%% Host: HP EliteDesk 800 G4 Mini (i5-8500T, 16 GB, 256 GB NVMe) — OWNED outright.
%% Substrate: Ubuntu Server 26.04 LTS bare-metal + Docker (no Proxmox).
%% Legend: solid = running now · dashed edge = telemetry / handoff · grey dashed node = not deployed
%% Deployment status verified on the box 2026-07-29: indexer, manager, dashboard and all three
%%   agents are up. Suricata, recon-runner, digest and triage exist in the repo but are NOT
%%   running — no suricata service in compose, no recon image built, no cron installed.
%% PIVOT NOTE: this replaced an earlier Proxmox/pfSense/VLAN topology. It trades
%%   network realism (pfSense, VLANs, Windows endpoint VMs) for portability +
%%   detection breadth.
%% Endpoints are Wazuh agents on REAL devices, not VMs — keeps the 16 GB budget clear.

    Internet((Internet))

    subgraph Host["HP EliteDesk 800 G4 Mini — Ubuntu 26.04 + Docker"]
        direction TB

        subgraph SocNet["docker network: soc"]
            Indexer["wazuh.indexer<br/>OpenSearch :9200<br/>heap 2g / cap 4g"]
            Manager["wazuh.manager<br/>:1514 agent, :1515 enroll, :55000 API<br/>custom-rules mount (Phase B)"]
            Dashboard["wazuh.dashboard<br/>:443 web UI"]
        end

        Suricata["suricata — NOT DEPLOYED (ISC-26)<br/>sniffs host NIC<br/>eve.json → manager"]

        subgraph ReconNet["docker network: recon_net (isolated)"]
            Recon["recon-runner — NOT DEPLOYED<br/>subfinder→httpx→nuclei→diff<br/>cron: run --rm, 2g cap"]
        end

        Digest["digest collector — NOT DEPLOYED<br/>generate_digest.py · cron 07:00<br/>→ {date}-intake.json"]
    end

    subgraph Endpoints["Real-device Wazuh agents (no VMs on the box) — all Active"]
        Win["Dell OptiPlex 7070 — talondellbox<br/>Windows 11 Pro · Sysmon + agent 001"]
        Mac["MacBook — talonmacbook<br/>filtered unified log · agent 003"]
        UbuntuHost["EliteDesk, self-monitoring — talonsoclab<br/>auditd + agent 002"]
    end

    Analyst(["Kyle — Analyst, on talonmacbook<br/>HTTPS to dashboard"])
    CASA["CASA — casa-ai-agent<br/>multi-agent reasoning on Claude<br/>(separate plane, not yet fed)"]
    Triage["triage/ queue — NOT DEPLOYED<br/>human review gate"]

    Internet ==> Host
    Win  -. "TLS 1514" .-> Manager
    Mac  -. "TLS 1514" .-> Manager
    UbuntuHost -. "TLS 1514" .-> Manager
    Suricata -. "eve.json" .-> Manager

    Manager --> Indexer
    Indexer --> Dashboard
    Analyst ==> Dashboard

    Recon --> Triage
    Indexer -. "alerts (level≥12)" .-> Digest
    Triage  -. "newest delta" .-> Digest
    Digest -. "intake.json (deterministic handoff)" .-> CASA
    CASA -. "explainable, NIST-aligned analysis" .-> Analyst

    classDef soc fill:#0f172a,stroke:#f59e0b,color:#fff
    classDef ep fill:#0f172a,stroke:#34d399,color:#fff
    classDef ext fill:#374151,stroke:#9ca3af,color:#fff
    classDef casa fill:#3b0764,stroke:#c084fc,color:#fff
    classDef planned fill:#111827,stroke:#6b7280,color:#9ca3af,stroke-dasharray:4 3

    class Indexer,Manager,Dashboard soc
    class Win,Mac,UbuntuHost ep
    class Internet,Analyst ext
    class Suricata,Recon,Digest,Triage planned
    class CASA casa

flowchart TB
%% TalonSocLab — Phase A Foundation SOC Stack
%% Single source of truth for VM names, VLANs, bridges, and data flow.
%% Host: shared Saguaros Proxmox node `tes1` — TalonSocLab is tenant-isolated via Pool + private bridge.
%%
%% TENANCY ISOLATION (see project-talonsoclab-tenancy memory):
%%   - All TalonSocLab VMs live in Proxmox Pool `talonsoclab` (ACL scoped to kylev only)
%%   - All TalonSocLab VMs are prefixed `kv-` and tagged `talonsoclab`
%%   - `vmbr0`     = SHARED uplink bridge (other tenants on it too) — pfSense WAN ONLY
%%   - `vmbrtalon` = PRIVATE lab bridge, VLAN-aware, NO physical NIC — all internal VLAN traffic
%%   - `vmbr1`     = NEIGHBOR TENANT (GOAD-Range) — DO NOT TOUCH

    Internet((Internet))
    SharedUplink["vmbr0 — shared uplink bridge<br/>(other tenants present)<br/>pfSense WAN only"]

    subgraph Saguaros["Saguaros Proxmox host `tes1` — Pool: talonsoclab"]
        direction TB

        pfSense["kv-pfsense-edge<br/>NIC1 → vmbr0 (WAN, DHCP)<br/>NIC2 → vmbrtalon (LAN trunk)<br/>VLANs 10 + 20"]

        TalonBridge["vmbrtalon — PRIVATE bridge<br/>no uplink, VLAN-aware<br/>carries VLAN 10 + 20"]

        subgraph Endpoints["Endpoints VLAN 10 — 10.10.10.0/24"]
            Win10["kv-win10-ep1<br/>10.10.10.11<br/>Sysmon + Wazuh agent"]
            WinSrv["kv-winsrv-ep2<br/>10.10.10.12<br/>Sysmon + Wazuh agent + WEF collector"]
            Ubuntu["kv-ubuntu-ep3<br/>10.10.10.21<br/>Wazuh agent + auditd"]
        end

        subgraph SOC["SOC VLAN 20 — 10.10.20.0/24"]
            WazuhMgr["kv-wazuh-soc — Manager<br/>10.10.20.10<br/>:1514 agent, :1515 enroll, :55000 API"]
            WazuhIdx["kv-wazuh-soc — Indexer<br/>10.10.20.10<br/>:9200 OpenSearch"]
            WazuhDash["kv-wazuh-soc — Dashboard<br/>10.10.20.10<br/>:443 web UI"]
        end

        Suricata["Suricata IDS<br/>on pfSense WAN<br/>eve.json → Wazuh"]
    end

    Analyst(["Kyle — Analyst<br/>HTTPS to pfSense + Wazuh via vmbr0 mgmt"])

    Internet ==> SharedUplink
    SharedUplink ==> pfSense
    pfSense -- "WAN tap" --> Suricata
    pfSense ==> TalonBridge
    TalonBridge ==> Endpoints
    TalonBridge ==> SOC

    Win10  -. "TLS 1514" .-> WazuhMgr
    WinSrv -. "TLS 1514" .-> WazuhMgr
    Ubuntu -. "TLS 1514" .-> WazuhMgr
    Suricata -. "filebeat → 1514" .-> WazuhMgr

    WazuhMgr --> WazuhIdx
    WazuhIdx --> WazuhDash
    Analyst ==> WazuhDash

    classDef edge fill:#1f2937,stroke:#60a5fa,color:#fff
    classDef ep fill:#0f172a,stroke:#34d399,color:#fff
    classDef soc fill:#0f172a,stroke:#f59e0b,color:#fff
    classDef ids fill:#1f2937,stroke:#f87171,color:#fff
    classDef ext fill:#374151,stroke:#9ca3af,color:#fff
    classDef bridge fill:#312e81,stroke:#a5b4fc,color:#fff

    class pfSense edge
    class Win10,WinSrv,Ubuntu ep
    class WazuhMgr,WazuhIdx,WazuhDash soc
    class Suricata ids
    class Internet,Analyst ext
    class SharedUplink,TalonBridge bridge

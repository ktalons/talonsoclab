#!/usr/bin/env bash
# ******************************************************************************
# *Title: pre-commit*
# *Author: Kyle Versluis*
# *Description: Block a commit that fails leakcheck or a staged-content check.*
# ******************************************************************************

# *--- Configuration ---*

# NOTE: installed by tools/hooks/install.sh, which writes a stub into .git/hooks
# that fails closed when this file is missing. A repo-level core.hooksPath would
# bypass the global dispatcher that calls the stub, so install.sh never sets one.
set -euo pipefail

shared="deploy/soc-recon/wazuh/shared/"
# What tools/coverage.ts builds from, and the folder it writes.
built=(
  deploy/soc-recon/wazuh/custom-rules/
  phase-b-detection/art-runs/
  phase-b-detection/attack/
  phase-b-detection/validation/
  phase-b-detection/coverage/
)

# *--- Entry Point ---*

root=$(git rev-parse --show-toplevel)
# SECURITY: fail closed. A missing scanner must stop the commit, not wave it through.
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found, so leakcheck cannot run. Commit blocked." >&2
  exit 1
fi
bun "$root/tools/leakcheck.ts" --staged
# ISA ISC-105: a commit that touches a shared agent group must carry a receipt from a
# verify-agent-conf run on the box that matches the staged files and the pinned image.
# SECURITY: fail closed. The listing's exit status is checked on its own, because a test
# on its output alone reads a git failure as "nothing staged under the shared folder".
if ! touched=$(git -C "$root" diff --cached --name-only -- "$shared"); then
  echo "pre-commit: git could not list the staged paths, so the agent.conf receipt cannot be checked. Commit blocked." >&2
  exit 1
fi
if [ -n "$touched" ]; then
  bun "$root/tools/agentconf-check.ts" --offline --staged
fi
# ISA ISC-169: a commit that touches a coverage input or output must hold outputs that
# equal a rebuild of the inputs it holds.
if ! changed=$(git -C "$root" diff --cached --name-only -- "${built[@]}"); then
  echo "pre-commit: git could not list the staged paths, so the coverage outputs cannot be checked. Commit blocked." >&2
  exit 1
fi
if [ -n "$changed" ]; then
  if ! copy=$(mktemp -d); then
    echo "pre-commit: no temp folder, so the coverage outputs cannot be checked. Commit blocked." >&2
    exit 1
  fi
  trap 'rm -rf "$copy"' EXIT
  # SECURITY: the check reads a copy of the index, never the working tree, with replace
  # refs off, so it sees the bytes the commit will hold.
  if ! git -C "$root" ls-files -z -- "${built[@]}" | GIT_NO_REPLACE_OBJECTS=1 git -C "$root" checkout-index -z --stdin --prefix="$copy/"; then
    echo "pre-commit: git could not copy the index, so the coverage outputs cannot be checked. Commit blocked." >&2
    exit 1
  fi
  bun "$root/tools/coverage.ts" check --root "$copy"
fi
